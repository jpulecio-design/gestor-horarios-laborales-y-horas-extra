# Copia este archivo a `.env` y completa los valores con tu instancia de Oracle.
# El backend no arranca en modo Oracle sin estas variables, pero la app igual
# levanta y las rutas que no usan base de datos siguen funcionando.

DB_USER=tu_usuario
DB_PASSWORD=tu_clave
DB_CONNECT_STRING=host:puerto/servicio

PORT=3000

# Notificaciones por Telegram (CU08). TELEGRAM_CHAT_ID es el chat del administrador.
TELEGRAM_BOT_TOKEN=token_del_bot
TELEGRAM_CHAT_ID=chat_del_administrador

# Backups (CU11). Carpeta donde se guardan los respaldos (opcional).
# Si se deja vacía se usa backend/respaldos. NUNCA debe ser una carpeta pública.
BACKUP_DIR=
# Carpeta donde la consola guarda las descargas (opcional). Por defecto la carpeta Descargas del usuario.
CARPETA_DESCARGAS=
