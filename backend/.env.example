# Copia este archivo a `.env` y completa los valores con tu instancia de Oracle.
# El backend no arranca en modo Oracle sin estas variables, pero la app igual
# levanta y las rutas que no usan base de datos siguen funcionando.

# Conexión a Oracle (se aceptan los prefijos DB_ u ORACLE_)
DB_USER=tu_usuario
DB_PASSWORD=tu_clave
DB_CONNECT_STRING=host:puerto/instancia

# Credenciales del administrador de Oracle (solo para scripts/crear-usuario.js)
ORACLE_SYS_USER=system
ORACLE_SYS_PASSWORD=tu_clave_de_system
ORACLE_SYS_CONNECT_STRING=localhost:1521/FREEPDB1

# Seguridad: clave para firmar los tokens de sesion (JWT).
# Cambiala por una cadena larga y aleatoria, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Notificaciones por Telegram (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

PORT=3000
