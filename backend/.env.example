# Copia este archivo a `.env` y completa los valores con tu instancia de Oracle.
# El backend no arranca en modo Oracle sin estas variables, pero la app igual
# levanta y las rutas que no usan base de datos siguen funcionando.

# Conexión a Oracle (se aceptan los prefijos DB_ u ORACLE_)
DB_USER=tu_usuario
DB_PASSWORD=tu_clave
